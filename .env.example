# Local configuration; .env is ignored. Never commit a real key.
# Pass dataset paths with --zip. DB defaults to data/cottonil.db.
# Set optional values in PowerShell via $env:NAME before launching.
# No API key is needed for offline analytics or Phase 0 tests.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_ROUNDS=4
GROQ_MAX_TOOLS=8
GROQ_OUTPUT_TOKENS=1000
GROQ_SESSION_CALLS=40
GROQ_SESSION_TOKENS=160000
